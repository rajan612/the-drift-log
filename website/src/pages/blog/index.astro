---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Subscribe from '../../components/Subscribe.astro';
import { SITE_DESCRIPTION } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="The Log | The Drift Log"
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>
			<section class="log-hero shell">
				<p class="log-kicker">LOG / FIELD NOTES</p>

				<h1>
					Notes from systems
					<span>that had opinions.</span>
				</h1>

				<p class="log-intro">
					Cloud infrastructure, platform engineering, SRE, networking,
					reliability, and the lessons that usually arrive after the
					architecture diagram is finished.
				</p>

				<div class="log-meta">
					<span>
						{posts.length.toString().padStart(2, '0')} ENTRIES
					</span>

					<a href="/rss.xml">RSS ↗</a>
				</div>
			</section>

			<section class="posts shell">
				<div class="posts-header">
					<span>ENTRY</span>
					<span>CHANGE LOG</span>
					<span>DATE</span>
				</div>

				<div class="post-list">
					{
						posts.map((post, index) => (
							<a
								class="post-row"
								href={`/blog/${post.id}/`}
							>
								<div class="post-number">
									{String(index + 1).padStart(2, '0')}
								</div>

								<div class="post-copy">
									<span class="post-type">
										FIELD NOTE
									</span>

									<h2>{post.data.title}</h2>

									<p>{post.data.description}</p>
								</div>

								<div class="post-date">
									<FormattedDate
										date={post.data.pubDate}
									/>
								</div>

								<span
									class="post-arrow"
									aria-hidden="true"
								>
									↗
								</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="subscribe-shell shell">
				<Subscribe />
			</section>
		</main>

		<Footer />
	</body>
</html>

<style>
	.log-hero {
		padding-top: 110px;
		padding-bottom: 96px;
		border-bottom: 1px solid var(--border);
	}

	.log-kicker {
		margin: 0 0 28px;
		color: var(--accent);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.64rem;
		letter-spacing: 0.11em;
	}

	.log-hero h1 {
		max-width: 940px;
		margin: 0;
		font-size: clamp(3.5rem, 7vw, 7rem);
		line-height: 0.92;
		letter-spacing: -0.06em;
		font-weight: 520;
	}

	.log-hero h1 span {
		display: block;
		color: var(--muted);
	}

	.log-intro {
		max-width: 690px;
		margin: 38px 0 0;
		color: #b8b5af;
		font-size: 1.05rem;
		line-height: 1.8;
	}

	.log-meta {
		display: flex;
		gap: 28px;
		margin-top: 46px;
		color: var(--muted);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.6rem;
		letter-spacing: 0.08em;
	}

	.log-meta a {
		color: var(--accent);
	}

	.posts {
		padding-top: 78px;
		padding-bottom: 110px;
	}

	.posts-header {
		display: grid;
		grid-template-columns: 74px minmax(0, 1fr) 120px;
		gap: 24px;
		padding: 0 24px 15px 0;
		color: var(--muted-2);
		border-bottom: 1px solid var(--border);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.55rem;
		letter-spacing: 0.09em;
	}

	.post-list {
		border-bottom: 1px solid var(--border);
	}

	.post-row {
		position: relative;
		display: grid;
		grid-template-columns: 74px minmax(0, 1fr) 120px 28px;
		gap: 24px;
		align-items: center;
		min-height: 210px;
		padding: 34px 24px 34px 0;
		border-bottom: 1px solid var(--border);

		transition:
			background 160ms ease,
			transform 160ms ease;
	}

	.post-row:last-child {
		border-bottom: 0;
	}

	.post-row:hover {
		background: var(--panel);
		transform: translateX(4px);
	}

	.post-number {
		align-self: start;
		padding-top: 4px;
		color: var(--muted-2);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.62rem;
	}

	.post-type {
		display: block;
		margin-bottom: 13px;
		color: var(--accent);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.55rem;
		letter-spacing: 0.09em;
	}

	.post-copy h2 {
		max-width: 820px;
		margin: 0;
		font-size: clamp(1.45rem, 2.6vw, 2.4rem);
		line-height: 1.08;
		letter-spacing: -0.035em;
		font-weight: 520;
	}

	.post-copy p {
		max-width: 760px;
		margin: 15px 0 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.post-date {
		align-self: start;
		padding-top: 25px;
		color: var(--muted);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.58rem;
	}

	.post-arrow {
		color: var(--muted);
		font-size: 1.15rem;

		transition:
			color 160ms ease,
			transform 160ms ease;
	}

	.post-row:hover .post-arrow {
		color: var(--accent);
		transform: translate(3px, -3px);
	}

	.subscribe-shell {
		padding-bottom: 110px;
	}

	@media (max-width: 760px) {
		.log-hero {
			padding-top: 76px;
			padding-bottom: 70px;
		}

		.log-hero h1 {
			font-size: clamp(3.2rem, 15vw, 5.2rem);
		}

		.posts {
			padding-top: 55px;
			padding-bottom: 80px;
		}

		.posts-header {
			display: none;
		}

		.post-row {
			grid-template-columns: 38px minmax(0, 1fr);
			min-height: 0;
			padding: 30px 0;
		}

		.post-date {
			grid-column: 2;
			padding-top: 0;
		}

		.post-arrow {
			display: none;
		}

		.subscribe-shell {
			padding-bottom: 80px;
		}
	}
</style>
---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Comments from '../components/Comments.astro';
import Subscribe from '../components/Subscribe.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | The Drift Log`} description={description} />
	</head>

	<body>
		<Header />

		<main>
			<article>
				<header class="article-header shell">
					<a class="back-link" href="/blog">← BACK TO LOG</a>

					<div class="article-meta">
						<span>FIELD NOTE</span>
						<span>•</span>
						<FormattedDate date={pubDate} />
						<span>•</span>
						<span class="view-count" data-page-view-count>— VIEWS</span>
					</div>

					<h1>{title}</h1>

					<p class="article-description">{description}</p>

					{
						updatedDate && (
							<p class="updated">
								LAST UPDATED <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>

				<div class="article-rule shell"></div>

				<div class="article-body shell">
					<div class="prose">
						<slot />
					</div>

					<aside class="article-rail">
						<div>
							<span>STATUS</span>
							<strong>PUBLISHED</strong>
						</div>

						<div>
							<span>FORMAT</span>
							<strong>FIELD NOTE</strong>
						</div>

						<div>
							<span>SOURCE</span>
							<strong>THE DRIFT LOG</strong>
						</div>
					</aside>
				</div>
					<section class="shell">
						<Subscribe />
						<Comments />
					</section>
				<section class="article-end shell">
					<p>// end of entry</p>
					<a href="/blog">VIEW ALL LOG ENTRIES →</a>
				</section>
			</article>
		</main>

		<Footer />
	</body>
</html>

<style>
	.article-header {
		max-width: 1120px;
		padding-top: 94px;
		padding-bottom: 70px;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 58px;
		color: var(--muted);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.58rem;
		letter-spacing: 0.08em;
	}

	.back-link:hover {
		color: var(--accent);
	}

	.article-meta {
		display: flex;
		gap: 11px;
		margin-bottom: 25px;
		color: var(--accent);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.59rem;
		letter-spacing: 0.08em;
	}

	.view-count {
		color: var(--muted);
	}

	.article-header h1 {
		max-width: 1050px;
		margin: 0;
		font-size: clamp(3rem, 6vw, 6.2rem);
		line-height: 0.96;
		letter-spacing: -0.055em;
		font-weight: 520;
	}

	.article-description {
		max-width: 760px;
		margin: 34px 0 0;
		color: #b8b5af;
		font-size: 1.08rem;
		line-height: 1.8;
	}

	.updated {
		margin: 24px 0 0;
		color: var(--muted);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.55rem;
		letter-spacing: 0.07em;
	}

	.article-rule {
		border-top: 1px solid var(--border);
	}

	.article-body {
		display: grid;
		grid-template-columns: minmax(0, 760px) 190px;
		justify-content: space-between;
		gap: 80px;
		padding-top: 82px;
		padding-bottom: 110px;
	}

	.prose {
		min-width: 0;
		color: #c9c5be;
		font-size: 1.03rem;
		line-height: 1.85;
	}

	:global(.prose > *:first-child) {
		margin-top: 0;
	}

	:global(.prose p) {
		margin: 0 0 26px;
	}

	:global(.prose h2) {
		margin: 72px 0 24px;
		color: var(--text);
		font-size: clamp(1.8rem, 3vw, 2.6rem);
		line-height: 1.1;
		letter-spacing: -0.035em;
		font-weight: 520;
	}

	:global(.prose h3) {
		margin: 48px 0 18px;
		color: var(--text);
		font-size: 1.3rem;
		font-weight: 520;
	}

	:global(.prose strong) {
		color: var(--text);
		font-weight: 600;
	}

	:global(.prose a) {
		color: var(--blue);
		border-bottom: 1px solid rgba(143, 199, 214, 0.35);
	}

	:global(.prose ul),
	:global(.prose ol) {
		margin: 0 0 30px;
		padding-left: 24px;
	}

	:global(.prose li) {
		margin: 9px 0;
		padding-left: 5px;
	}

	:global(.prose blockquote) {
		margin: 42px 0;
		padding: 3px 0 3px 25px;
		border-left: 2px solid var(--accent);
		color: var(--text);
		font-size: 1.12rem;
		line-height: 1.75;
	}

	:global(.prose code) {
		padding: 2px 6px;
		border: 1px solid var(--border);
		background: var(--panel);
		color: var(--blue);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.88em;
	}

	:global(.prose pre) {
		overflow-x: auto;
		margin: 34px 0;
		padding: 22px 24px;
		border: 1px solid var(--border);
		background: #0f1214 !important;
		line-height: 1.65;
	}

	:global(.prose pre code) {
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		font-size: 0.86rem;
	}

	:global(.prose hr) {
		margin: 56px 0;
		border: 0;
		border-top: 1px solid var(--border);
	}

	.article-rail {
		align-self: start;
		position: sticky;
		top: 110px;
		border-top: 1px solid var(--border);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
	}

	.article-rail div {
		padding: 15px 0;
		border-bottom: 1px solid var(--border);
	}

	.article-rail span,
	.article-rail strong {
		display: block;
	}

	.article-rail span {
		margin-bottom: 6px;
		color: var(--muted-2);
		font-size: 0.5rem;
		letter-spacing: 0.08em;
	}

	.article-rail strong {
		color: var(--muted);
		font-size: 0.56rem;
		font-weight: 400;
	}

	.article-end {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 30px;
		padding-top: 32px;
		padding-bottom: 74px;
		border-top: 1px solid var(--border);
		font-family:
			ui-monospace,
			SFMono-Regular,
			Menlo,
			Monaco,
			Consolas,
			monospace;
		font-size: 0.59rem;
	}

	.article-end p {
		margin: 0;
		color: var(--muted-2);
	}

	.article-end a {
		color: var(--accent);
	}

	@media (max-width: 900px) {
		.article-body {
			grid-template-columns: 1fr;
		}

		.article-rail {
			display: none;
		}
	}

	@media (max-width: 680px) {
		.article-header {
			padding-top: 64px;
		}

		.back-link {
			margin-bottom: 42px;
		}

		.article-header h1 {
			font-size: clamp(2.8rem, 13vw, 4.6rem);
		}

		.article-body {
			padding-top: 58px;
			padding-bottom: 80px;
		}

		.article-end {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>